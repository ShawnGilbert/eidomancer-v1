{"body":{"branch_id":"B1","constraint_refs":[{"id":"record:sha256:5737e38e9e5e4c6a6214d51ced7f66690a62fd3f7bcb549db8799012d5cee25b","kind":"constraint","required":true,"schema_version":"eidomancer.record.schema.v0.2"},{"id":"record:sha256:b66a1d46b27e8c726a887fd4b9d4d8c37bec652739effece5a8fd8c11aad02e8","kind":"constraint","required":true,"schema_version":"eidomancer.record.schema.v0.2"},{"id":"record:sha256:6ba48f60cdd814e4aadbc2b0fab5bd354eefd6e1ed5549fde363cc7caed9c0a2","kind":"constraint","required":true,"schema_version":"eidomancer.record.schema.v0.2"},{"id":"record:sha256:8881e19cc450b5068b1b016aa2c797d3a2a6d01b3555801e16914bb0ace7e0fd","kind":"constraint","required":true,"schema_version":"eidomancer.record.schema.v0.2"},{"id":"record:sha256:582173f5b8951b6a13f3fd5bbda5e176840186f1e088b6390eb87fae14ccb1c2","kind":"constraint","required":true,"schema_version":"eidomancer.record.schema.v0.2"}],"creator_operation_ref":{"id":"record:sha256:73a74731008b6d65d9aeb7dcf99ff5ee1f5d28fe2262682cbf162ecc1eef201a","kind":"operation","required":true,"schema_version":"eidomancer.record.schema.v0.2"},"description":"Residents organize work around the lagoon as a repeating four-phase schedule. At level 0 they mark a narrow walking lane across the exposed stone band and use it for moving tools and supplies. After dusk raises the water to level 1, the lane remains usable, so crossings continue while residents gather floating reeds near one end of the band without placing them on the stone. At the next dusk the level advances to 2 and the band becomes submerged. Crossing stops. Residents then release a bundled portion of the gathered reeds over a selected section beside, rather than directly within, the marked walking lane. While the stone remains submerged through levels 2 and 3, some of those reeds take root, establishing one patch. Residents use ordinary hand tools from the shore to keep additional floating reeds away from the rest of the band. After the following dusk returns the level from 3 to 0, the stone is exposed and walkable again. The rooted patch remains on its selected section, while the previously marked lane is kept clear enough for residents to resume crossing. The arrangement therefore divides use of the same band by both phase and location: exposed phases are reserved for access and transport, submerged phases for controlled reed establishment and maintenance. The persistent rooted patch gives residents a fixed feature to manage on later cycles without requiring any alteration of the water cycle or the stone itself.","facts":{"rooted_reed_patches":1,"water_level":0},"intelligence_response_ref":{"id":"record:sha256:1fdd0c2396cf3d9e1db0694aaab86ae8d33d1c9bf2d777e9cad4b262c7298a8e","kind":"intelligence_response","required":true,"schema_version":"eidomancer.record.schema.v0.2"},"rule_set_ref":{"id":"record:sha256:160332dbc409d7a8b8f670efc168a9ded69008366468b821af61a09308f85b90","kind":"rule_set","required":true,"schema_version":"eidomancer.record.schema.v0.2"},"seed_ref":{"id":"record:sha256:61922c6cc811cec3855bc5a044dd679699c5842aedb77cbdc273b40ea6ea2da1","kind":"seed","required":true,"schema_version":"eidomancer.record.schema.v0.2"}},"canonicalization_version":"eidomancer.jcs.v1","claim_class":"generated_candidate","kind":"world_state","provenance":{"actor_role":"environment","identification_status":"declared","input_refs":[{"id":"record:sha256:73a74731008b6d65d9aeb7dcf99ff5ee1f5d28fe2262682cbf162ecc1eef201a","kind":"operation","required":true,"schema_version":"eidomancer.record.schema.v0.2"},{"id":"record:sha256:1fdd0c2396cf3d9e1db0694aaab86ae8d33d1c9bf2d777e9cad4b262c7298a8e","kind":"intelligence_response","required":true,"schema_version":"eidomancer.record.schema.v0.2"}],"model_or_version":"fictional.generic.v1","provider":"eidomancer"},"refs":[{"id":"record:sha256:160332dbc409d7a8b8f670efc168a9ded69008366468b821af61a09308f85b90","kind":"rule_set","required":true,"schema_version":"eidomancer.record.schema.v0.2"},{"id":"rec