# Use the Render dashboard or the root .env locally. Never put these in mobile/.env.
OPENAI_API_KEY=
MOBILE_MODEL=gpt-5.4-mini-2026-03-17
# Initialize the file once on a verified persistent volume. Use the same ledger after restart.
MOBILE_SPEND_DB=
MOBILE_MONTHLY_API_BUDGET_USD=5
MOBILE_REPORT_KEY=
MOBILE_REPORT_DIR=
MOBILE_SUPPORT_EMAIL=
PORT=3002
MOBILE_TRUST_PROXY_HOPS=0
MOBILE_READINGS_PER_IP_HOUR=60
MOBILE_READINGS_PER_DAY=400
MOBILE_REPORTS_PER_DAY=400

# production (default), sandbox (isolated beta DB), or local (loopback only).
MOBILE_ACCESS_MODE=production
MOBILE_ENTITLEMENT_KEY=
MOBILE_ENTITLEMENT_DB=
MOBILE_PLAY_LICENSE_KEY=
MOBILE_PLAY_VERSIONS=1
MOBILE_APPLE_TEAM_ID=
MOBILE_APPLE_APP_ID=
MOBILE_APPLE_ROOT_FILES=
MOBILE_INSTALL_DAILY=3
MOBILE_OWNER_DAILY=5
MOBILE_OWNER_LIFETIME=250
